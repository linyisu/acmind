# 本地开发环境配置
# 本地运行时使用 localhost，Docker 环境使用 mysql

# MySQL (本地开发)
DATABASE_URL=mysql://acmind:acmind@localhost:3306/acmind

# API
API_PORT=8080
RUST_LOG=info,acmind_api=debug

# JWT
JWT_SECRET=change-me-in-production-please
JWT_EXPIRES_IN=86400

# Web
VITE_API_BASE_URL=http://localhost:8080
WEB_PORT=5173

# 注册开关（生产建议 false）
ALLOW_REGISTER=true

# 限流（每秒请求数 + 突发容量，开发时设大些）
RATE_LIMIT_PER_SECOND=10000
RATE_LIMIT_BURST=10000

# AI（noop = mock 响应，openai = OpenAI 兼容 API）
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
